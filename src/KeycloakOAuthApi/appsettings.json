{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Authentication": {
    "Audience": "public-client",
    "Issuer": "http://localhost:8081/realms/auth",
    "MetadataAddress": "http://localhost:8081/realms/auth/.well-known/openid-configuration"
  },
  "Keycloak": {
    "ClientId": "public-client",
    "Issuer": "http://localhost:8081/realms/auth",
    "MetadataAddress": "http://localhost:8081/realms/auth/.well-known/openid-configuration",
    "AuthorizationUrl": "http://localhost:8081/realms/auth/protocol/openid-connect/auth",
    "TokenUrl": "http://localhost:8081/realms/auth/protocol/openid-connect/token"
  },
  "AllowedHosts": "*"
}
